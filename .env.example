# ---------------------------------------------------------------------------
# PLACEHOLDER NAMES ONLY. Never put real values in this file.
#
# Server-side (Cloudflare Pages > Settings > Environment variables, and
# secrets via `wrangler pages secret put`). These are never sent to the browser.
# For `wrangler pages dev` locally, copy this file to `.dev.vars` (git-ignored).
# ---------------------------------------------------------------------------

# Supabase project (Settings > API). The service key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). Ask before adding.
TURNSTILE_SECRET=

# 32-byte key (base64) used to encrypt sensitive fields at rest before they
# reach Postgres. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# KV namespace id used for the per-IP submission rate limit.
RATE_LIMIT_KV_ID=

# Absolute origin used to build links inside confirmation emails.
PUBLIC_APP_ORIGIN=

# Email provider adapter: "dev" (console + outbound_emails table) or a real one.
# Supported real provider: "knock" (knock.app orchestration -> Postmark delivery).
EMAIL_PROVIDER=dev
EMAIL_FROM=

# Knock. The secret key is a Cloudflare secret: `wrangler pages secret put
# KNOCK_SECRET_KEY`. Get it from knock.app > Platform > API keys > Create API
# key (type Secret). Never commit the value, and never expose it to the browser.
KNOCK_SECRET_KEY=
# The key of the workflow whose email step renders the confirmation. This one is
# not secret - it is a plain Pages environment variable.
KNOCK_WORKFLOW_KEY=

# Optional numeric overrides.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Client-visible build-time variables (public by design, still never a secret).
# ---------------------------------------------------------------------------

# Supabase project URL and the *anon* key, used only for staff sign-in on /admin.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Turnstile site key rendered into the application form widget.
VITE_TURNSTILE_SITE_KEY=
